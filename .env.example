# All variables below are optional — the app works out of the box against
# public production endpoints with no .env file at all. Copy this file to
# .env.local and uncomment/override only what you need.

# Starknet RPC endpoint used for transaction polling and on-chain reads.
# Default: https://rpc.provable.games/rpc
# VITE_RPC_URL=

# Collectables API base URL serving the Beasts v3 (MOBs) collection (beast list,
# filters, species, stats) — the same deployment lootsurvivor.io uses.
# Default: https://api-next-5655.up.railway.app
# VITE_COLLECTABLES_API_URL=

# Beasts NFT contract address.
# Default: 0x00f739e402e52830a736335a0f47d58ec78ba067443c9c6930da182eab2ff8b0 (Beasts v3)
# VITE_BEASTS_ADDRESS=

# Torii SQL endpoint used for beast queries (in dev this is proxied via /torii, see vite.config.ts).
# Default: https://torii-production-7359.up.railway.app/sql
# VITE_TORII_SQL_ENDPOINT=

# Base URL for the Arcade Torii node (order/listing data), used to derive the GraphQL endpoint below.
# Default: https://torii-production-7359.up.railway.app
# VITE_ARCADE_TORII_BASE=

# Arcade Torii SQL endpoint for direct order-status queries (in dev this is proxied via /arcade).
# Default: https://torii-production-7359.up.railway.app/sql
# VITE_ARCADE_TORII_SQL=

# Marketplace (Arcade) contract address.
# Default: 0x06bbf16b6c67b1bef27a187b499b2f3a14af31646c2c90d64f11b9087c3f527c
# VITE_MARKETPLACE_ADDRESS=

# ERC-20 token addresses accepted as marketplace payment currencies.
# Defaults are the mainnet LORDS/SURVIVOR addresses.
# VITE_TOKEN_LORDS=
# VITE_TOKEN_SURVIVOR=

# Fallback conversion rates (token -> STRK) used only if the live rates API is unreachable.
# VITE_RATE_LORDS_IN_STRK=
# VITE_RATE_USDC_IN_STRK=
# VITE_RATE_ETH_IN_STRK=
# VITE_RATE_SURVIVOR_IN_STRK=

# Summit API base URL (legacy-beasts Summit data: profile Summit rank, Summit
# tab, unclaimed skulls). Summit features are OFF unless this is set; the old
# summit-api-production Railway service was retired with the v3 migration.
# VITE_SUMMIT_API_URL=

# Torii SQL endpoint for the legacy relayer_0_0_1 world, used by "Claim CORPSE".
# Cartridge's pg-mainnet-10 Slot that served it is discontinued; corpse claiming
# stays hidden unless a self-hosted Torii for that world is set here.
# VITE_CORPSE_TORII_SQL=

# Controller username lookup API (best-effort; falls back to showing addresses).
# Default: https://api.cartridge.gg/accounts/lookup
# VITE_ACCOUNTS_LOOKUP_URL=

# Marketplace on/off. Off (default) hides the tab, buy/offer/cart actions and
# redirects /marketplace to home.
# Set to true to enable it (locally for testing, then in production to unhide).
# VITE_MARKETPLACE_ENABLED=
